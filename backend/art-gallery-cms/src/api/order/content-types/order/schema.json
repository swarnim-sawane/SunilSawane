{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Order"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "orderNumber": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "customerName": {
      "type": "string",
      "required": true
    },
    "customerEmail": {
      "type": "string",
      "required": true
    },
    "customerPhone": {
      "type": "string"
    },
    "artworks": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::artwork.artwork",
      "inversedBy": "orders"
    },
    "totalAmount": {
      "type": "decimal"
    },
    "orderStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "confirmed",
        "payment_review",
        "failed",
        "expired",
        "refunded",
        "processing",
        "shipped",
        "delivered"
      ]
    },
    "paymentId": {
      "type": "string",
      "unique": true
    },
    "razorpayOrderId": {
      "type": "string",
      "unique": true
    },
    "expectedAmountPaise": {
      "type": "integer"
    },
    "paymentCurrency": {
      "type": "string",
      "default": "INR"
    },
    "gatewayStatus": {
      "type": "string"
    },
    "paymentMethod": {
      "type": "string"
    },
    "paymentVerifiedAt": {
      "type": "datetime"
    },
    "reservationExpiresAt": {
      "type": "datetime"
    },
    "reservationTokenHash": {
      "type": "string",
      "private": true
    },
    "reservationOwnerHash": {
      "type": "string",
      "private": true
    },
    "emailStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "sending",
        "sent",
        "partial",
        "failed"
      ],
      "default": "pending"
    },
    "emailDelivery": {
      "type": "json"
    },
    "emailAttemptedAt": {
      "type": "datetime"
    },
    "paymentSignature": {
      "type": "string",
      "private": true
    },
    "orderDate": {
      "type": "datetime"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "pincode": {
      "type": "string"
    },
    "orderItems": {
      "type": "json"
    },
    "shippingAddress": {
      "type": "text",
      "required": true
    },
    "orderNotes": {
      "type": "text"
    }
  }
}
