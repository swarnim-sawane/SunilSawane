{
  "kind": "collectionType",
  "collectionName": "artworks",
  "info": {
    "singularName": "artwork",
    "pluralName": "artworks",
    "displayName": "Artwork"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "Description": {
      "type": "blocks"
    },
    "price": {
      "type": "decimal"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "artworks"
    },
    "dimensions": {
      "type": "string"
    },
    "medium": {
      "type": "string"
    },
    "yearCreated": {
      "type": "integer"
    },
    "isAvailable": {
      "type": "boolean",
      "default": true
    },
    "availabilityStatus": {
      "type": "enumeration",
      "enum": [
        "available",
        "reserved",
        "sold",
        "not_for_sale"
      ],
      "required": true,
      "default": "available"
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "isFeatured": {
      "type": "boolean",
      "default": false
    },
    "framingStatus": {
      "type": "enumeration",
      "enum": [
        "unframed",
        "framed",
        "framing_available",
        "to_be_confirmed"
      ],
      "default": "to_be_confirmed"
    },
    "shippingNote": {
      "type": "text"
    },
    "certificateNote": {
      "type": "text"
    },
    "orders": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::order.order",
      "mappedBy": "artworks"
    }
  }
}
