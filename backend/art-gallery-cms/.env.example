NODE_ENV=development
DEPLOYMENT_STAGE=staging
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337
FRONTEND_URL=http://127.0.0.1:8765
CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:8765
REMOTE_DATA_TRANSFER_ENABLED=false
TRUST_PROXY=false

APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

CLOUDINARY_ENABLED=false
CLOUDINARY_NAME=replace_me
CLOUDINARY_KEY=replace_me
CLOUDINARY_SECRET=replace_me
CLOUDINARY_FOLDER=sunilsawane-artworks

RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me
PAYMENT_RESERVATION_MINUTES=20
PAYMENT_MAX_RESERVED_ARTWORKS_PER_CLIENT=3

ORDER_NOTIFICATION_EMAIL=sunilsawaneart@gmail.com
ORDER_EMAIL_FROM=orders@localhost
ORDER_REPLY_TO=sunilsawaneart@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=

